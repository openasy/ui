{
  "name": "@openasy/ui",
  "version": "0.10.0",
  "description": "React component library shared by every OpenAsy product: shell, tables, charts, KPIs, filters and standard severity levels.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/ui.git"
  },
  "homepage": "https://openasy.github.io/ui/",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "vite"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./vite/colophon.d.ts",
      "import": "./vite/colophon.js"
    },
    "./colophon": {
      "types": "./vite/client.d.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -p tsconfig.build.json && cp -R src/messages dist/types/messages",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook",
    "test:ci": "OA_REPORTS=1 vitest run --coverage",
    "report": "node scripts/collect-test-results.mjs",
    "build-storybook": "storybook build -o storybook-static",
    "pages": "npm run test:ci; npm run report && npm run build-storybook"
  },
  "prettier": "@openasy/code-style/prettier",
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.2",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "1.87.0",
    "playwright": "^1.64.1",
    "prettier": "3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  }
}
